<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express "cleartext only to user-approved RFC1918 literals".
         TransportPolicy enforces that boundary before every request. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
